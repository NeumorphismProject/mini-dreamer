# API 配置示例
# 复制此文件为 .env.local 并填入实际值

# API 基础地址（服务端使用）
API_BASE_URL=https://your-api-url.com
API_TOKEN=your-api-token-here

# 下载地址配置（服务端使用，可选）
BAIDU_PAN_URL=https://pan.baidu.com/s/your-share-code
QUARK_PAN_URL=https://pan.quark.cn/s/your-share-code

# 哔哩哔哩博主视频首页地址（客户端使用，需 NEXT_PUBLIC_ 前缀）
NEXT_PUBLIC_BILIBILI_URL=https://space.bilibili.com/your-uid